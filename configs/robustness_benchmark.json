      {"name": "combined_compensated", "position_noise_std_m": 0.15, "yaw_noise_std_deg": 1.0, "speed_noise_std_mps": 0.20, "actuation_delay_steps": 2, "plant_wheelbase_scale": 1.15, "delay_compensation": true}
